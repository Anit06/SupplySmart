PORT=5000
MONGO_URI=mongodb://localhost:27017/supply_chain

RAZORPAY_KEY_ID=rzp_test_replace_with_sandbox_key_id
RAZORPAY_KEY_SECRET=replace_with_sandbox_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
RAZORPAY_API_TIMEOUT_MS=10000
JWT_SECRET=replace_with_a_long_random_jwt_secret

# Configure this public endpoint in the Razorpay Test Mode webhook dashboard.
# Replace the host with the HTTPS URL of this Node API:
# https://api.example.com/api/payment/webhook
PUBLIC_API_BASE_URL=https://api.example.com

# Server-to-server inventory service. Never use REACT_APP_* or VITE_* for this token.
# Generate one 32-byte base64url token and configure the same value in Java.
# This is the service base URL; Node appends /api/inventory and the operation path.
JAVA_SERVICE_URL=http://127.0.0.1:8080
JAVA_SERVICE_TIMEOUT_MS=10000
JAVA_SERVICE_TOKEN=replace-with-generated-secret
PYTHON_SERVICE_URL=http://127.0.0.1:5001
PYTHON_SERVICE_TIMEOUT_MS=10000
