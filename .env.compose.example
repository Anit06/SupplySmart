# Local Compose only. Generate unique values; do not reuse production secrets.
APP_HTTP_PORT=8088
MONGO_ROOT_USERNAME=supplychain_local
MONGO_ROOT_PASSWORD=replace-with-a-long-alphanumeric-random-password
JAVA_SERVICE_TOKEN=replace-with-output-of-32-byte-base64url-generation
JWT_SECRET=replace-with-a-long-random-jwt-secret
JAVA_SERVICE_TIMEOUT_MS=10000
PYTHON_SERVICE_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=20
CORS_ORIGINS=http://localhost:5173
CHECKOUT_RECOVERY_INTERVAL_MS=60000

# Optional Razorpay sandbox credentials. Leave empty to disable online payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_TIMEOUT_MS=10000

# Dedicated synthetic users and data for the opt-in k6 test only.
LT_USER_PREFIX=loadtest-user-
LT_USER_DOMAIN=example.invalid
LT_USER_PASSWORD=
LT_WAREHOUSE_ID=
LT_PRODUCT_ID=
LT_QUANTITY=1
